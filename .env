# Configuração do Cesar Market (CTF).
# No Linux/EC2, execute `sh infra/init-env.sh` nesta pasta para gerar o .env
# com senhas aleatórias e estes comentários. Um .env existente é preservado.
# Versione somente o .env.example; o .env contém as credenciais da instalação.

# Porta HTTP publicada no host/EC2 para este app. Ex.: http://IP_DA_EC2:8081.
# O Nginx continua usando a porta 80 dentro do container.
APP_PORT=8081

# Nome do banco criado no MariaDB na primeira inicialização.
# Mudar este valor depois não renomeia nem migra o banco existente.
DB_DATABASE=cesar_market

# Usuário do banco utilizado pelo app PHP, separado do usuário root do MariaDB.
# É criado no primeiro provisionamento; mantenha compatível com o banco existente.
DB_USERNAME=cesar_market

# Senha do usuário DB_USERNAME. O script init-env.sh preenche automaticamente.
# Mudar somente esta linha não altera a senha já gravada no MariaDB.
DB_PASSWORD=9913c486bdd58ea79c245c063e8fbccb23283f7ad93ada6f

# Senha administrativa do usuário root do MariaDB, criada na primeira inicialização.
# O app PHP usa DB_USERNAME/DB_PASSWORD. Esta senha deve ser diferente das demais.
# Mudar somente esta linha também não redefine a senha root de um banco existente.
DB_ROOT_PASSWORD=13a9a38fe11212d34b73003e3f185c4b2ce4aae437c6cd6b1d16c94f41afc1e2

# Nome exibido na conta administradora criada no primeiro provisionamento.
# Não altera automaticamente uma conta já existente.
ADMIN_NAME=Administrador Cesar

# Login inicial do administrador do Cesar Market (não é a conta do CTFd).
# Novos cadastros públicos continuam recebendo o perfil user.
# Alterar aqui não renomeia a conta administrativa já criada no banco.
ADMIN_LOGIN=administrador

# Senha inicial do administrador: use de 12 a 72 caracteres aleatórios.
# O init-env.sh gera essa senha; depois do cadastro, troque-a em Minha conta.
# Alterar somente o .env não redefine a senha de uma conta existente.
ADMIN_PASSWORD=9a5734eb8627c200d35dcdac7631415e9084e3d9

# true: o navegador só envia o cookie de sessão deste app por HTTPS.
# Mantenha false nos testes por HTTP e use true quando o Cesar Market tiver HTTPS.
# Esta opção se refere ao HTTPS do próprio app, não ao endereço do CTFd abaixo.
SESSION_SECURE=false

# Crédito virtual de boas-vindas, em centavos: 5000 = R$ 50,00.
# É concedido uma única vez ao criar uma conta; não altera saldos já existentes.
WELCOME_CREDIT_CENTS=5000

# Taxa de entrega dos pedidos, em centavos: 790 = R$ 7,90.
# As opções de entrega padrão e agendada usam esta mesma taxa.
DELIVERY_FEE_CENTS=790

# Endereço público da plataforma CTFd (EC2 1), acessível no navegador do jogador.
# Inclua http:// ou https://; pode incluir a porta quando necessário.
# Ex.: https://plataforma.seudominio.com ou http://203.0.113.10:60000.
# Não acrescente /tutorials: o botão Preso? -> Laboratórios acrescenta esse caminho.
# http://localhost serve apenas para testar com o CTFd na própria máquina.
# Ao mudar uma variável usada pelo PHP, recrie app; apenas restart não atualiza o ambiente.
CTFD_BASE_URL=http://localhost



FLAG=ESQUENTA["fora_da_caixa":"77af778b51abd4a3c51c5ddd97204a9c3ae614ebccb75a606c3b6865aed6744e"]
